# Copie para ".env" nesta mesma pasta (deploy/vps/) e preencha os valores reais.
# Este arquivo serve dois propósitos ao mesmo tempo: o docker-compose usa
# POSTGRES_PASSWORD pra substituir ${POSTGRES_PASSWORD} no docker-compose.yml,
# e o container da API recebe TODAS as variáveis abaixo via `env_file: .env`.
# Por isso o valor de POSTGRES_PASSWORD tem que ser o MESMO nos dois lugares
# em que aparece (na variável solta e dentro de DATABASE_URL).

POSTGRES_PASSWORD=troque-por-uma-senha-forte

ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://orbit:troque-por-uma-senha-forte@db:5432/orbit
JWT_SECRET=
GEMINI_API_KEY=
CORS_ORIGINS=https://orbit.advogadaleticiabarros.com.br
RESEND_API_KEY=
EMAIL_FROM=Orbit <onboarding@resend.dev>
RESEND_WEBHOOK_SECRET=
PUBLIC_API_URL=https://api.orbit.advogadaleticiabarros.com.br
ENABLE_SCHEDULER=true
ENCRYPTION_KEY=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://api.orbit.advogadaleticiabarros.com.br/integracoes/instagram/callback
FRONTEND_URL=https://orbit.advogadaleticiabarros.com.br
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.orbit.advogadaleticiabarros.com.br/integracoes/google-business/callback
GROQ_API_KEY=
TAVILY_API_KEY=
BLOG_SFTP_HOST=147.93.38.211
BLOG_SFTP_PORT=65002
BLOG_SFTP_USER=u528898188
BLOG_SFTP_PASSWORD=
BLOG_SFTP_PATH=/home/u528898188/domains/advogadaleticiabarros.com.br/public_html/blog/
